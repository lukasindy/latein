{"id":"perfekt","t":"Perfekt und Plusquamperfekt","s":"A-/E-Konjugation und esse","r":["Perfektstamm: Präsensstamm auf -a → -av-, auf -e → -u-.","Perfektendungen: -i, -isti, -it, -imus, -istis, -erunt. Infinitiv Perfekt: -isse.","Plusquamperfekt = Perfektstamm + Imperfekt von esse: -eram, -eras, -erat, -eramus, -eratis, -erant.","esse: Perfektstamm fu-: fui, fuisti, fuit, fuimus, fuistis, fuerunt; Plusquamperfekt fueram …"],"T":[{"n":"laudare, Perfekt/Plusquamperfekt","c":["Perfekt","Plusquamperfekt"],"r":[["1. Pers. Sg.","laudavi","laudaveram"],["2. Pers. Sg.","laudavisti","laudaveras"],["3. Pers. Sg.","laudavit","laudaverat"],["1. Pers. Pl.","laudavimus","laudaveramus"],["2. Pers. Pl.","laudavistis","laudaveratis"],["3. Pers. Pl.","laudaverunt","laudaverant"]]},{"n":"monere, Perfekt/Plusquamperfekt","c":["Perfekt","Plusquamperfekt"],"r":[["1. Pers. Sg.","monui","monueram"],["2. Pers. Sg.","monuisti","monueras"],["3. Pers. Sg.","monuit","monuerat"],["1. Pers. Pl.","monuimus","monueramus"],["2. Pers. Pl.","monuistis","monueratis"],["3. Pers. Pl.","monuerunt","monuerant"]]},{"n":"esse, Perfekt/Plusquamperfekt","c":["Perfekt","Plusquamperfekt"],"r":[["1. Pers. Sg.","fui","fueram"],["2. Pers. Sg.","fuisti","fueras"],["3. Pers. Sg.","fuit","fuerat"],["1. Pers. Pl.","fuimus","fueramus"],["2. Pers. Pl.","fuistis","fueratis"],["3. Pers. Pl.","fuerunt","fuerant"]]}],"Q":[["laudavit heißt:","er hat gelobt",["er lobte (Imperfekt)","er wird loben","er hatte gelobt"],""],["monuerant heißt:","sie hatten gemahnt",["sie haben gemahnt","sie mahnten","sie werden mahnen"],""],["fuerat heißt:","er war gewesen",["er ist gewesen","er war","er wird gewesen sein"],""],["Der Perfektstamm von laudare lautet …","laudav-",["laud-","laudu-","laudat-"],""],["Der Perfektstamm von monere lautet …","monu-",["monav-","mon-","monit-"],""],["Der Infinitiv Perfekt Aktiv endet auf …","-isse",["-are","-ri","-urum esse"],""]]},
{"id":"sperrung","t":"Sperrung und Wortstellung","s":"zusammengehörige Wörter getrennt","r":["Zusammengehörige Wörter werden zur besonderen Hervorhebung durch eingeschobene, schwächer betonte Wörter getrennt.","Getrennt wird meist durch Präposition, Adverb, Pronomen, Attribut oder Verb.","Lateinisch: Adjektiv – Präposition/Adverb/Pronomen/Attribut/Verb – Substantiv. Deutsch: Präposition/Adverb/Pronomen – Adjektiv – Substantiv."],"T":[],"Q":[["summo in periculo heißt:","in höchster Gefahr",["in der Gefahr des Gipfels","höchste Gefahr herrscht","mit höchster Gefahr"],""],["tertio iam die heißt:","schon am dritten Tag",["am dritten Tag danach","dritter Tag, jetzt","nach drei Tagen"],""],["bonus ille vir heißt:","jener gute Mann",["der Mann, der gut war","jener Mann ist gut","guter Mann, jener"],""],["prima Romanorum victoria heißt:","der erste Sieg der Römer",["der Sieg der ersten Römer","der Sieg, den die Römer errangen","erste Römer siegten"],""],["magna est gloria senatus heißt:","groß ist der Ruhm des Senates",["der Senat ist groß","der große Ruhm ist beim Senat","der Ruhm des großen Senates"],""],["bonus es homo heißt:","du bist ein guter Mensch",["der gute Mensch ist da","er ist ein guter Mensch","ihr seid gute Menschen"],""]]},
{"id":"demonstrativ","t":"Demonstrativpronomen","s":"is, idem, hic, ille, iste, ipse","r":["is, ea, id = er, sie, es / dieser, diese, dieses","idem, eadem, idem = derselbe, dieselbe, dasselbe","hic, haec, hoc = dieser, diese, dieses","ille, illa, illud = jener, jene, jenes","iste, ista, istud = dieser da, diese da, dieses da","ipse, ipsa, ipsum = selbst (auch: derselbe)"],"T":[{"n":"is, ea, id (Singular)","c":["m","f","n"],"r":[["1. Fall","is","ea","id"],["2. Fall","eius","eius","eius"],["3. Fall","ei","ei","ei"],["4. Fall","eum","eam","id"],["6. Fall","eo","ea","eo"]]},{"n":"is, ea, id (Plural)","c":["m","f","n"],"r":[["1. Fall","ii","eae","ea"],["2. Fall","eorum","earum","eorum"],["3. Fall","iis","iis","iis"],["4. Fall","eos","eas","ea"],["6. Fall","iis","iis","iis"]]},{"n":"idem, eadem, idem (Singular)","c":["m","f","n"],"r":[["1. Fall","idem","eadem","idem"],["2. Fall","eiusdem","eiusdem","eiusdem"],["3. Fall","eidem","eidem","eidem"],["4. Fall","eundem","eandem","idem"],["6. Fall","eodem","eadem","eodem"]]},{"n":"idem, eadem, idem (Plural)","c":["m","f","n"],"r":[["1. Fall","iidem","eaedem","eadem"],["2. Fall","eorundem","earundem","eorundem"],["3. Fall","iisdem","iisdem","iisdem"],["4. Fall","eosdem","easdem","eadem"],["6. Fall","iisdem","iisdem","iisdem"]]},{"n":"hic, haec, hoc (Singular)","c":["m","f","n"],"r":[["1. Fall","hic","haec","hoc"],["2. Fall","huius","huius","huius"],["3. Fall","huic","huic","huic"],["4. Fall","hunc","hanc","hoc"],["6. Fall","hoc","hac","hoc"]]},{"n":"hic, haec, hoc (Plural)","c":["m","f","n"],"r":[["1. Fall","hi","hae","haec"],["2. Fall","horum","harum","horum"],["3. Fall","his","his","his"],["4. Fall","hos","has","haec"],["6. Fall","his","his","his"]]},{"n":"ille, illa, illud (Singular)","c":["m","f","n"],"r":[["1. Fall","ille","illa","illud"],["2. Fall","illius","illius","illius"],["3. Fall","illi","illi","illi"],["4. Fall","illum","illam","illud"],["6. Fall","illo","illa","illo"]]},{"n":"ille, illa, illud (Plural)","c":["m","f","n"],"r":[["1. Fall","illi","illae","illa"],["2. Fall","illorum","illarum","illorum"],["3. Fall","illis","illis","illis"],["4. Fall","illos","illas","illa"],["6. Fall","illis","illis","illis"]]},{"n":"iste, ista, istud (Singular)","c":["m","f","n"],"r":[["1. Fall","iste","ista","istud"],["2. Fall","istius","istius","istius"],["3. Fall","isti","isti","isti"],["4. Fall","istum","istam","istud"],["6. Fall","isto","ista","isto"]]},{"n":"iste, ista, istud (Plural)","c":["m","f","n"],"r":[["1. Fall","isti","istae","ista"],["2. Fall","istorum","istarum","istorum"],["3. Fall","istis","istis","istis"],["4. Fall","istos","istas","ista"],["6. Fall","istis","istis","istis"]]},{"n":"ipse, ipsa, ipsum (Singular)","c":["m","f","n"],"r":[["1. Fall","ipse","ipsa","ipsum"],["2. Fall","ipsius","ipsius","ipsius"],["3. Fall","ipsi","ipsi","ipsi"],["4. Fall","ipsum","ipsam","ipsum"],["6. Fall","ipso","ipsa","ipso"]]},{"n":"ipse, ipsa, ipsum (Plural)","c":["m","f","n"],"r":[["1. Fall","ipsi","ipsae","ipsa"],["2. Fall","ipsorum","ipsarum","ipsorum"],["3. Fall","ipsis","ipsis","ipsis"],["4. Fall","ipsos","ipsas","ipsa"],["6. Fall","ipsis","ipsis","ipsis"]]}],"Q":[["idem, eadem, idem heißt:","derselbe, dieselbe, dasselbe",["jener, jene, jenes","selbst","dieser da"],""],["ille, illa, illud heißt:","jener, jene, jenes",["dieser, diese, dieses","derselbe","selbst"],""],["hic, haec, hoc heißt:","dieser, diese, dieses",["jener","derselbe","dieser da"],""],["iste, ista, istud heißt:","dieser da, diese da, dieses da",["jener","selbst","derselbe"],""],["ipse, ipsa, ipsum heißt:","selbst",["derselbe","jener","dieser da"],""]]},
{"id":"genitiv-dativ","t":"Genitiv/Dativ possessivus, Genitiv subj./obj.","s":"hic hortus est avi","r":["Lateinischer Satz: Subjekt + esse + Genitiv/Dativ.","Deutsch, 1. Möglichkeit: Subjekt → Subjekt, esse → gehören, Genitiv/Dativ → Dativ.","Deutsch, 2. Möglichkeit: Subjekt → Akkusativ, esse → haben/besitzen, Genitiv/Dativ → Subjekt.","Genitivus subiectivus: Genitiv mit Bezug zum Subjekt, meist als reiner Genitiv übersetzt. Genitivus obiectivus: Genitiv als Objekt, meist mit Präposition (zum, für, …) übersetzt."],"T":[],"Q":[["Hic hortus est avi. heißt (gehören):","Dieser Garten gehört dem Großvater.",["Dieser Garten ist der Großvater.","Der Großvater gehört zu diesem Garten.","Dieser Garten ist alt."],""],["Libri antiqui sunt discipulorum. heißt:","Die alten Bücher gehören den Schülern.",["Die alten Bücher sind die Schüler.","Die Schüler gehören zu den Büchern.","Alte Schüler haben Bücher."],""],["Sunt nobis multi amici. heißt:","Wir haben viele Freunde.",["Unsere vielen Freunde sind da.","Wir sind viele Freunde.","Viele Freunde gehören uns nicht."],""],["amor patriae heißt:","die Liebe zum Vaterland (Genitivus obiectivus)",["die Liebe des Vaterlandes (Gen. subiectivus)","das Vaterland der Liebe","die Liebe vom Vater"],""],["amor matris kann heißen:","Liebe der Mutter (subj.) oder Liebe zur Mutter (obj.)",["nur Liebe der Mutter","nur Liebe zur Mutter","Mutterliebe zum Vater"],""]]},
{"id":"passiv1","t":"Passiv (A-/E-Konjugation)","s":"laudor, monebar, laudabor","r":["Passivendungen: -(o)r, -ris, -tur, -mur, -mini, -ntur.","Tempuszeichen bleiben: Präsens –, Imperfekt -ba-, Futur -b-/-be-/-bi-/-bu-.","Passiver Infinitiv Präsens: Stamm inkl. Vokal + -ri (laudari, moneri).","Übersetzung: meist Passiv, manchmal aktiv + rückbezüglich (In hoc lacu lavor. = Ich wasche mich in diesem See), manchmal aktiv + „man“ + dass (bei ACI/NCI)."],"T":[{"n":"laudari, Passiv","c":["Präsens","Imperfekt","Futur I"],"r":[["1. Pers. Sg.","laudor","laudabar","laudabor"],["2. Pers. Sg.","laudaris","laudabaris","laudaberis"],["3. Pers. Sg.","laudatur","laudabatur","laudabitur"],["1. Pers. Pl.","laudamur","laudabamur","laudabimur"],["2. Pers. Pl.","laudamini","laudabamini","laudabimini"],["3. Pers. Pl.","laudantur","laudabantur","laudabuntur"]]},{"n":"moneri, Passiv","c":["Präsens","Imperfekt","Futur I"],"r":[["1. Pers. Sg.","moneor","monebar","monebor"],["2. Pers. Sg.","moneris","monebaris","moneberis"],["3. Pers. Sg.","monetur","monebatur","monebitur"],["1. Pers. Pl.","monemur","monebamur","monebimur"],["2. Pers. Pl.","monemini","monebamini","monebimini"],["3. Pers. Pl.","monentur","monebantur","monebuntur"]]}],"Q":[["laudabantur heißt:","sie wurden gelobt",["sie werden gelobt","sie lobten","sie werden gelobt werden"],""],["monebitur heißt:","er wird gemahnt werden",["er wird gemahnt","er wurde gemahnt","er wird mahnen"],""],["laudari heißt:","gelobt (zu) werden",["loben","gelobt haben","gelobt worden sein"],""],["In hoc lacu lavor. übersetzt man besser:","Ich wasche mich in diesem See.",["Ich werde in diesem See gewaschen.","Ich wasche diesen See.","Man wäscht diesen See."],""],["Die Passivendung der 2. Person Plural lautet …","-mini",["-mur","-ntur","-ris"],""]]},
{"id":"kons-konj","t":"Konsonantische Konjugation","s":"ducere, legere, dicere","r":["Präsens: Stamm + teils Bindevokal -/-i-/-u- + -o, -s, -t, -mus, -tis, -nt. Im Stowasser alt: -o3, neu: Infinitiv -ere.","Imperfekt: Stamm + Bindevokal (e) + -ba-. Futur: Stamm (ohne Vokal) + -a-/-e- + Endung.","Passiv: dieselben Stämme mit Passivendungen, Infinitiv Passiv Stamm + -i (duci, legi).","Perfektstamm unregelmäßig: Dehnung (legere – legi), Reduplikation (discere – didici), -si/-xi (dicere – dixi), -ui (colere – colui). Im Stowasser steht die Perfektform in der 1. Person Sg."],"T":[{"n":"ducere (führen), Aktiv","c":["Präsens","Imperfekt","Futur I"],"r":[["1. Pers. Sg.","duco","ducebam","ducam"],["2. Pers. Sg.","ducis","ducebas","duces"],["3. Pers. Sg.","ducit","ducebat","ducet"],["1. Pers. Pl.","ducimus","ducebamus","ducemus"],["2. Pers. Pl.","ducitis","ducebatis","ducetis"],["3. Pers. Pl.","ducunt","ducebant","ducent"]]},{"n":"ducere, Passiv","c":["Präsens","Imperfekt","Futur I"],"r":[["1. Pers. Sg.","ducor","ducebar","ducar"],["2. Pers. Sg.","duceris","ducebaris","duceris"],["3. Pers. Sg.","ducitur","ducebatur","ducetur"],["1. Pers. Pl.","ducimur","ducebamur","ducemur"],["2. Pers. Pl.","ducimini","ducebamini","ducemini"],["3. Pers. Pl.","ducuntur","ducebantur","ducentur"]]},{"n":"ducere, Perfekt/Plusquamperfekt","c":["Perfekt","Plusquamperfekt"],"r":[["1. Pers. Sg.","duxi","duxeram"],["2. Pers. Sg.","duxisti","duxeras"],["3. Pers. Sg.","duxit","duxerat"],["1. Pers. Pl.","duximus","duxeramus"],["2. Pers. Pl.","duxistis","duxeratis"],["3. Pers. Pl.","duxerunt","duxerant"]]}],"Q":[["Der Imperativ Sg. von ducere lautet (unregelmäßig):","duc!",["duce!","duci!","ducere!"],""],["Der Imperativ von legere (regelmäßig) lautet:","lege!",["leg!","legi!","legit!"],""],["Der Infinitiv Passiv von ducere lautet:","duci",["ducere","duceri","ducari"],""],["duxi heißt:","ich habe geführt",["ich führe","ich führte","ich werde führen"],""],["Perfekt von legere:","legi",["legavi","legui","lexi"],""],["Perfekt von dicere:","dixi",["dicui","dici","dicavi"],""],["Perfekt von discere (lernen):","didici",["discui","disci","discavi"],""],["Perfekt von colere (pflegen):","colui",["coli","colavi","colxi"],""],["Was steht im alten Stowasser bei der konsonantischen Konjugation?","1. Person Sg. mit Ziffer 3 (-o3)",["Infinitiv -are","Ziffer 2 (-eo2)","Ziffer 4 (-io4)"],""]]},
{"id":"ppp-ppa","t":"PPP, PPA und Participium coniunctum","s":"laudatus, laudans, Perfekt Passiv","r":["PPP (Partizip Perfekt Passiv): Stamm inkl. Vokal (A) bzw. Vokaländerung e → i (E) + -tus3 (laudatus, monitus). Dekliniert nach A-/O-Deklination.","Verwendung: Perfekt Passiv (PPP + esse im Präsens), Plusquamperfekt Passiv (PPP + esse im Imperfekt), Futur exakt; adjektivisch (vir laudatus = der gelobte Mann); selten substantivisch.","PPA (Partizip Präsens): Präsensstamm + -ns (A-Konj. -ans, sonst -ens), dekliniert nach der Mischdeklination. Übersetzung: adjektivisch (lobend), als gleichzeitiger Gliedsatz oder selten substantivisch.","Participium coniunctum: Partizip (PPP/PPA) + Nomen, übereinstimmend in KNG, meist durch Sperrung getrennt. Übersetzung als eigener Glied- oder Hauptsatz, das Partizip wird zum Prädikat."],"T":[{"n":"laudare, Perfekt Passiv","c":["Perfekt Passiv","Plusquamperfekt Passiv"],"r":[["1. Pers. Sg.","laudatus/-a sum","laudatus/-a eram"],["2. Pers. Sg.","laudatus/-a es","laudatus/-a eras"],["3. Pers. Sg.","laudatus/-a/-um est","laudatus/-a/-um erat"],["1. Pers. Pl.","laudati/-ae sumus","laudati/-ae eramus"],["2. Pers. Pl.","laudati/-ae estis","laudati/-ae eratis"],["3. Pers. Pl.","laudati/-ae/-a sunt","laudati/-ae/-a erant"]]},{"n":"laudans (lobend), PPA","c":["Sg.","Pl."],"r":[["1. Fall","laudans","laudantes/laudantia"],["2. Fall","laudantis","laudantium"],["3. Fall","laudanti","laudantibus"],["4. Fall","laudantem/laudans","laudantes/laudantia"],["6. Fall","laudante","laudantibus"]]}],"Q":[["laudatus heißt:","gelobt",["lobend","um zu loben","loben"],""],["laudans heißt:","lobend",["gelobt","gelobt worden","zu loben"],""],["Das PPP drückt im Participium coniunctum aus:","Vorzeitigkeit",["Gleichzeitigkeit","Nachzeitigkeit","Wunsch"],""],["Das PPA drückt aus:","Gleichzeitigkeit",["Vorzeitigkeit","Nachzeitigkeit","Befehl"],""],["laudati sumus heißt:","wir sind gelobt worden",["wir haben gelobt","wir werden gelobt","wir lobten"],""],["monitus erat heißt:","er war gemahnt worden",["er wurde gemahnt","er ist gemahnt worden","er hatte gemahnt"],""],["Homines Daedalum cum filio per caelum volantem viderunt. heißt:","Die Menschen sahen Daedalus, der mit seinem Sohn durch den Himmel flog.",["Die Menschen flogen mit Daedalus und seinem Sohn.","Daedalus sah die fliegenden Menschen mit seinem Sohn.","Die fliegenden Menschen sahen Daedalus."],""],["Graeci ex equo liberati portas urbis Troiae aperuerunt. heißt:","Die Griechen, die aus dem Pferd befreit worden waren, öffneten die Tore der Stadt Troja.",["Die Griechen befreiten das Pferd aus der Stadt Troja.","Die befreiten Tore öffneten die Griechen.","Die Griechen öffneten das Pferd und befreiten Troja."],""],["Wie wird Perfekt Passiv gebildet?","PPP + esse im Präsens",["PPP + esse im Imperfekt","Perfektstamm + -eram","Stamm + -ba- + -r"],""]]},
{"id":"relativ","t":"Relativpronomen","s":"qui, quae, quod","r":["Relativpronomen: bezieht sich auf ein Wort aus dem vorangehenden Hauptsatz und leitet einen Gliedsatz ein (welcher/der, die, das).","Relativer Anschluss: bezieht sich auf ein Wort des vorangehenden Satzes und leitet einen Hauptsatz ein (dieser, er, sie, es).","Adjektivisches Fragepronomen: bezieht sich auf das nachstehende Wort (welcher).","Verwechslungsgefahr: quod kann auch „da, weil“ heißen."],"T":[{"n":"qui, quae, quod (Singular)","c":["m","f","n"],"r":[["1. Fall","qui","quae","quod"],["2. Fall","cuius","cuius","cuius"],["3. Fall","cui","cui","cui"],["4. Fall","quem","quam","quod"],["6. Fall","quo","qua","quo"]]},{"n":"qui, quae, quod (Plural)","c":["m","f","n"],"r":[["1. Fall","qui","quae","quae"],["2. Fall","quorum","quarum","quorum"],["3. Fall","quibus","quibus","quibus"],["4. Fall","quos","quas","quae"],["6. Fall","quibus","quibus","quibus"]]}],"Q":[["quod kann bedeuten:","welches oder weil",["nur welches","nur weil","dass nicht"],""],["Der relative Anschluss leitet … ein.","einen Hauptsatz",["einen Gliedsatz","einen Fragesatz","einen Wunschsatz"],""],["Das Relativpronomen leitet … ein.","einen Gliedsatz",["einen Hauptsatz","einen Wunschsatz","keinen Satz"],""]]},
{"id":"dritte","t":"Dritte Deklination","s":"Konsonanten-, I- und Mischstämme","r":["Kennzeichen: Genitiv endet auf -is. Konsonantenstämme: Stamm (Genitiv ohne -is) endet auf Konsonant, der Nominativ weicht oft vom Stamm ab (rex, regis).","I-Stämme stimmen weitgehend überein, aber: Akk. Sg. -im (statt -em), Abl. Sg. -i (statt -e), Nom./Akk. Pl. Neutrum -ia (statt -a), Gen. Pl. -ium (statt -um).","Mischstämme: Nom. und Gen. Sg. haben gleich viele Silben ODER der Stamm endet auf zwei Konsonanten. Gen. Pl. -ium.","Häufige Typen: -er, -(e)ris (m); -or, -oris (m); -l, -lis (m); -o, -onis (f); -x, -cis/-gis (f); -as, -atis (f); -us, -utis (f)/-oris/-eris (n); -men, -minis (n); -ur, -ris (n).","Verwechslungsgefahr: vir, viri (der Mann, O-Dekl.), virus, viri (das Gift, O-Dekl. n.) und vis (Kraft, Gewalt, I-Stamm)."],"T":[{"n":"consul (Konsul), m","c":["Sg.","Pl."],"r":[["1. Fall","consul","consules"],["2. Fall","consulis","consulum"],["3. Fall","consuli","consulibus"],["4. Fall","consulem","consules"],["5. Fall","consul","consules"],["6. Fall","consule","consulibus"]]},{"n":"vox (Stimme), f","c":["Sg.","Pl."],"r":[["1. Fall","vox","voces"],["2. Fall","vocis","vocum"],["3. Fall","voci","vocibus"],["4. Fall","vocem","voces"],["5. Fall","vox","voces"],["6. Fall","voce","vocibus"]]},{"n":"tempus (Zeit), n","c":["Sg.","Pl."],"r":[["1. Fall","tempus","tempora"],["2. Fall","temporis","temporum"],["3. Fall","tempori","temporibus"],["4. Fall","tempus","tempora"],["5. Fall","tempus","tempora"],["6. Fall","tempore","temporibus"]]},{"n":"fulgur (Blitz), n","c":["Sg.","Pl."],"r":[["1. Fall","fulgur","fulgura"],["2. Fall","fulguris","fulgurum"],["3. Fall","fulguri","fulguribus"],["4. Fall","fulgur","fulgura"],["5. Fall","fulgur","fulgura"],["6. Fall","fulgure","fulguribus"]]},{"n":"turris (Turm), I-Stamm f","c":["Sg.","Pl."],"r":[["1. Fall","turris","turres"],["2. Fall","turris","turrium"],["3. Fall","turri","turribus"],["4. Fall","turrim","turres"],["5. Fall","turris","turres"],["6. Fall","turri","turribus"]]},{"n":"mare (Meer), I-Stamm n","c":["Sg.","Pl."],"r":[["1. Fall","mare","maria"],["2. Fall","maris","marium"],["3. Fall","mari","maribus"],["4. Fall","mare","maria"],["5. Fall","mare","maria"],["6. Fall","mari","maribus"]]},{"n":"dens (Zahn), Mischstamm","c":["Sg.","Pl."],"r":[["1. Fall","dens","dentes"],["2. Fall","dentis","dentium"],["3. Fall","denti","dentibus"],["4. Fall","dentem","dentes"],["5. Fall","dens","dentes"],["6. Fall","dente","dentibus"]]},{"n":"vulpes (Fuchs), Mischstamm","c":["Sg.","Pl."],"r":[["1. Fall","vulpes","vulpes"],["2. Fall","vulpis","vulpium"],["3. Fall","vulpi","vulpibus"],["4. Fall","vulpem","vulpes"],["5. Fall","vulpes","vulpes"],["6. Fall","vulpe","vulpibus"]]}],"Q":[["rex, regis heißt:","König",["Konsul","Stimme","Gefängnis"],""],["carcer, carceris heißt:","Gefängnis",["König","Arbeit","Blitz"],""],["labor, laboris heißt:","Arbeit",["Vernunft","Zeit","Gefängnis"],""],["ratio, rationis heißt:","Vernunft",["Arbeit","Zeit","Stimme"],""],["aetas, aetatis heißt:","Zeit, Zeitalter",["Licht","Blitz","Gefängnis"],""],["lumen, luminis heißt:","Licht",["Zeit","Blitz","Stimme"],""],["Der Akkusativ Sg. der I-Stämme endet auf …","-im",["-em","-ium","-ia"],""],["Der Abl. Sg. der I-Stämme endet auf …","-i",["-e","-ibus","-im"],""],["Der Nom. Pl. n. der I-Stämme endet auf …","-ia",["-a","-es","-ium"],""],["Der Gen. Pl. der I-Stämme endet auf …","-ium",["-um","-ibus","-ia"],""],["vir, viri heißt:","der Mann",["das Gift","die Kraft","der Zahn"],""],["virus, viri heißt:","das Gift",["der Mann","die Kraft","der Fuchs"],""],["vis (Nom. Sg.) heißt:","Kraft, Gewalt",["der Mann","das Gift","du willst"],"Auch vis = du willst (volo, vis, vult). Nicht verwechseln!"],["Woran erkennt man Mischstämme?","gleich viele Silben in Nom. und Gen. Sg. oder Stamm auf zwei Konsonanten",["Gen. endet auf -ae","Nom. endet auf -us","Gen. endet auf -ei"],""]]}
